    "@node-rs/argon2": "^2.2.2",
    "@reservas/shared": "*",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
