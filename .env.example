DATABASE_URL=postgres://postgres:postgres@localhost:5432/reservas

# Endereço público do site (usado nos links dos e-mails).
PUBLIC_URL=http://localhost:5173

# E-mail. Em desenvolvimento, o Mailpit (docker compose) recebe tudo em http://localhost:8025.
# Sem SMTP_URL nenhum e-mail é enviado.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Pincelada <reservas@localhost>"

# Usuário da equipe criado por `npm run db:seed` (só desenvolvimento; em produção use `npm run staff:create`).
SEED_STAFF_EMAIL=equipe@pincelada.local
SEED_STAFF_PASSWORD=pincelada-dev-123
