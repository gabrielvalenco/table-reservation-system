{
  "name": "table-reservation-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:seed": "npm run seed -w apps/api",
    "staff:create": "npm run staff:create -w apps/api --",
    "demo:concurrency": "npm run demo:concurrency -w apps/api",
    "bench:availability": "npm run bench:availability -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "prepare": "npm run build -w packages/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
